# Token de la integración interna de Notion (Settings → Connections → Develop or manage integrations).
# Compartí la página "Portal del cliente" con la integración.
NOTION_TOKEN=ntn_xxx

# API key de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# Token de Meta: idealmente un token de "usuario del sistema" del Business Manager de la agencia
# (no vence). Si un cliente usa otro token, poné su nombre de variable en token_env en clientes.yaml.
META_ACCESS_TOKEN=EAAG...

# Opcionales
# CLAUDE_MODEL=claude-opus-5
# META_API_VERSION=v23.0
# DIR_DATOS=datos
