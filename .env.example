# Token de la integración interna de Notion (Settings → Connections → Develop or manage integrations).
# Compartí la página "Portal del cliente" con la integración.
NOTION_TOKEN=ntn_xxx

# API key de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx

# Clientes en Business Manager: un token de "usuario del sistema" por portfolio (no vence).
# El default es META_ACCESS_TOKEN; para los demás portfolios, poné el nombre de la variable
# en token_env del cliente en clientes.yaml.
META_ACCESS_TOKEN=EAAG...
# META_TOKEN_PORTFOLIO2=EAAG...

# Clientes que solo tienen Instagram (conexion: instagram).
# Salen de la app de Meta → Instagram → "Configuración de la API con inicio de sesión de Instagram".
# La redirect URI tiene que estar cargada igual en esa pantalla (puede ser la web de la agencia).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://holamarketing.com.ar/

# Opcionales
# CLAUDE_MODEL=claude-opus-5
# META_API_VERSION=v23.0
# DIR_DATOS=datos
